{
  "name": "bonbon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts --open /admin.html",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:booking": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:payment": "vitest run",
    "test": "npm run test:booking && npm run test:payment",
    "typecheck:payment": "tsc -b --pretty false && tsc -p tsconfig.payment-tests.json",
    "build:payment-sandbox": "tsc -b && vite build --config vite.payment-sandbox.config.ts --mode payment-sandbox"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@microsoft/signalr": "^8.0.29",
    "@phosphor-icons/react": "^2.1.10",
    "leaflet": "^1.9.4",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
